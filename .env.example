# --- Meeting Room Booking: environment ---
# Copy to .env and adjust. Secrets NEVER committed.

# Postgres connection (v1: single Postgres)
DATABASE_URL=postgres://mrb:mrb@127.0.0.1:5433/mrb

# HTTP
PORT=3000
HOST=0.0.0.0

# Session cookie (secure-session). Must be a strong random string, >= 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# Fixed salt for the secure-session key derivation (16 chars). Rotate = invalidate all sessions.
SESSION_SALT=mrb-session-salt

# Cookies: set true behind HTTPS (production). Dev over http can be false.
COOKIE_SECURE=false

# Single org display timezone for v1 (D5). Per-office tz is v2.
ORG_DISPLAY_TZ=Asia/Kolkata

# Booking policy (F9 defaults; OQ#6). Durations in minutes; horizon in days.
BOOKING_SLOT_MINUTES=15
BOOKING_MAX_DURATION_MINUTES=480
BOOKING_HORIZON_DAYS=30

# Dev-only embedded Postgres (rootless). Used by `npm run db:dev`.
DEV_PG_PORT=5433
DEV_PG_DATA=.pgdata
